# Application
NODE_ENV=development
APP_NAME=QanoAI WhatsAppSupport
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
REALTIME_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://qanoai:qanoai_dev_password@localhost:5432/qanoai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_SECRET=change_this_to_a_64_char_random_string_in_production
AUTH_ENCRYPTION_KEY=change_this_to_a_32_char_random_string_in_prod

# Encryption
CREDENTIAL_ENCRYPTION_KEY=change_this_to_a_32_char_random_string

# Email
EMAIL_FROM=noreply@qanoai.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_api_key_change_in_production
EVOLUTION_WEBHOOK_BASE_URL=http://host.docker.internal:3001/v1/webhooks/evolution

# Object Storage (MinIO for dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=qanoai-private
S3_ACCESS_KEY_ID=qanoai-minio
S3_SECRET_ACCESS_KEY=qanoai-minio-password

# AI Providers
OPENAI_API_KEY=sk-your-openai-key-or-gemini-key
# Optional: point the OpenAI SDK at an OpenAI-compatible endpoint (e.g. Gemini)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_DEFAULT_CHAT_MODEL=gpt-4o-mini
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=30000

# Queue
QUEUE_PREFIX=qanoai

# Real-time
REALTIME_PORT=3002

# Security
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=info

# Feature Flags
FEATURE_BILLING_ENABLED=false
FEATURE_N8N_ENABLED=false
N8N_WEBHOOK_BASE_URL=
