NODE_ENV=production
PORT=3001
DATABASE_URL=${DATABASE_URL}
REDIS_URL=${REDIS_URL}
AUTH_SECRET=${AUTH_SECRET}
AUTH_ENCRYPTION_KEY=${AUTH_ENCRYPTION_KEY}
CREDENTIAL_ENCRYPTION_KEY=${CREDENTIAL_ENCRYPTION_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
AI_DEFAULT_CHAT_MODEL=gpt-4o-mini
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EVOLUTION_API_URL=${EVOLUTION_API_URL}
EVOLUTION_API_KEY=${EVOLUTION_API_KEY}
# REQUIRED whenever EVOLUTION_API_URL is set. The webhook endpoint is public;
# without this value every inbound webhook is rejected and no WhatsApp message
# is processed. Set it, then re-register the webhook so Evolution sends it back.
EVOLUTION_WEBHOOK_SECRET=${EVOLUTION_WEBHOOK_SECRET}
EVOLUTION_WEBHOOK_BASE_URL=${EVOLUTION_WEBHOOK_BASE_URL}
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
S3_BUCKET_PRIVATE=qanoai-private
S3_REGION=us-east-1
EMAIL_FROM=noreply@qanoai.com
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
QUEUE_PREFIX=qanoai
LOG_LEVEL=info

# --- Voice cost rates (halalas per minute) ---
# The voice spending circuit breaker measures spend from these two rates. While
# both are 0 the breaker cannot price a call, so any organization that has set a
# voice budget will have its calls REFUSED rather than run unmetered. Set real
# figures from your Twilio and OpenAI Realtime pricing before enabling voice.
# Example only - replace with your actual contracted rates:
#   VOICE_TELEPHONY_COST_PER_MINUTE_MINOR=5
#   VOICE_AI_COST_PER_MINUTE_MINOR=34
VOICE_TELEPHONY_COST_PER_MINUTE_MINOR=
VOICE_AI_COST_PER_MINUTE_MINOR=
